rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public visitors can read the class yearbook.
    match /members/{memberId} {
      allow read: if true;
      // Replace YOUR_ADMIN_UID with the exact UID from Firebase Authentication.
      allow create, update, delete: if request.auth != null
        && request.auth.uid == '9Dk0KYkx9NRtcW6pStFwdoLbOPr2';
    }
    match /memories/{memoryId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == '9Dk0KYkx9NRtcW6pStFwdoLbOPr2';
    }
  }
}
