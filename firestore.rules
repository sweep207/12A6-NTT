rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        request.auth.uid == 'YNS2wHqzFAPQS8tiFVDDpVLRlAM2';
    }

    // Khách truy cập được xem danh sách thành viên.
    // Chỉ quản trị viên mới được thêm, sửa hoặc xóa.
    match /members/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Khách truy cập được xem kỷ niệm.
    // Chỉ quản trị viên mới được thêm, sửa hoặc xóa.
    match /memories/{memoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Mọi collection khác mặc định bị từ chối nếu không có rule cho phép.
  }
}
