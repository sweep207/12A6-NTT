rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isRootAdmin() {
      return request.auth != null &&
        request.auth.uid == 'YNS2wHqzFAPQS8tiFVDDpVLRlAM2';
    }

    function isAdmin() {
      return request.auth != null && (
        isRootAdmin() ||
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.enabled == true)
      );
    }

    match /members/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /memories/{memoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Private photo collection: never readable by public visitors.
    match /privatePhotos/{photoId} {
      allow read, create, update, delete: if isAdmin();
    }

    match /adminUsers/{userId} {
      // An authenticated user may read their own role document to sign in.
      allow get: if request.auth != null &&
        (request.auth.uid == userId || isAdmin());
      // Only the fixed root UID can list, grant, edit, or revoke admin roles.
      allow list: if isRootAdmin();
      allow create, update, delete: if isRootAdmin();
    }
  }
}