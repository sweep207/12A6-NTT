rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Fixed bootstrap admin plus administrators explicitly approved in adminUsers.
    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == 'YNS2wHqzFAPQS8tiFVDDpVLRlAM2' ||
        (exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/adminUsers/$(request.auth.uid)).data.enabled == true)
      );
    }

    // Public visitors can read the yearbook; only approved admins can modify it.
    match /members/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /memories/{memoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Only an already-authorized admin can manage the administrator allowlist.
    match /adminUsers/{userId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}